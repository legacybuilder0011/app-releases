    <string name="privacy_title">Your screen stays private</string>
    <string name="privacy_body">TapCopy only captures the screen after you tap its floating button. Text recognition happens on this device. Screenshots are stored temporarily in the app cache and deleted after use.</string>
    <string name="how_to_use">How it works</string>
    <string name="step_one">1. Enable TapCopy in Accessibility Settings.</string>
    <string name="step_two">2. Open TikTok, Instagram, Pinterest, or another app.</string>
    <string name="step_three">3. Tap the floating T button.</string>
    <string name="step_four">4. Tap a highlighted caption block to copy it.</string>
