    <string name="service_name">TapCopy screen text service</string>
    <string name="accessibility_service_description">Shows a user-controlled floating button. When you tap it, TapCopy takes one screenshot, recognizes visible text on-device, and lets you copy the text you choose. It does not read passwords, type for you, automate other apps, or upload screenshots.</string>
    <string name="enable_service">Enable TapCopy</string>
