<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="16dp">

                <!-- Top bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/menuButton"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_menu"
                        android:tint="@color/ink" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/proBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/pro_badge"
                        android:text="👑 Pro"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_gravity="center_horizontal"
                    android:text="TapCopy"
                    android:textColor="@color/ink"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Copy anything. Instantly."
                    android:textColor="@color/muted"
                    android:textSize="16sp" />

                <!-- Main status card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/card_background"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="26dp">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:background="@drawable/glow_ring"
                        android:gravity="center"
                        android:text="T"
                        android:textColor="#FFFFFF"
                        android:textSize="46sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/service_disabled"
                        android:textColor="@color/ink"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Tap the floating button anywhere to capture text."
                        android:textColor="@color/muted"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/enableButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/button_primary"
                        android:text="@string/enable_service"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- 2x2 feature grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardHistory"
                        style="@style/HomeTile"
                        android:layout_marginEnd="6dp">

                        <ImageView style="@style/TileIcon" android:src="@drawable/ic_history" />
                        <TextView style="@style/TileTitle" android:text="@string/open_history" />
                        <TextView style="@style/TileSub" android:text="View and reuse your copied text" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardAi"
                        style="@style/HomeTile"
                        android:layout_marginStart="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView style="@style/TileIcon" android:src="@drawable/ic_ai" />
                            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/pro_badge"
                                android:text="PRO"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView style="@style/TileTitle" android:text="AI Tools" />
                        <TextView style="@style/TileSub" android:text="Rewrite, translate and improve text" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/cardFav"
                        style="@style/HomeTile"
                        android:layout_marginEnd="6dp">

                        <ImageView style="@style/TileIcon" android:src="@drawable/ic_heart" />
                        <TextView style="@style/TileTitle" android:text="Favourites" />
                        <TextView style="@style/TileSub" android:text="Save important captions" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardSettings"
                        style="@style/HomeTile"
                        android:layout_marginStart="6dp">

                        <ImageView style="@style/TileIcon" android:src="@drawable/ic_settings" />
                        <TextView style="@style/TileTitle" android:text="Settings" />
                        <TextView style="@style/TileSub" android:text="Customize your experience" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Upgrade banner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/banner_bg"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚀  Unlock full power"
                        android:textColor="@color/ink"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Unlimited history, AI tools, and advanced features."
                        android:textColor="@color/muted"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/upgradeButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/button_primary"
                        android:text="Upgrade to Pro"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Bottom navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_elevated"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <LinearLayout android:id="@+id/navHome" style="@style/NavItem">
                <ImageView style="@style/NavIcon" android:src="@drawable/ic_home" android:tint="@color/brand" />
                <TextView style="@style/NavLabel" android:text="Home" android:textColor="@color/brand" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navHistory" style="@style/NavItem">
                <ImageView style="@style/NavIcon" android:src="@drawable/ic_history" android:tint="@color/faint" />
                <TextView style="@style/NavLabel" android:text="History" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navAi" style="@style/NavItem">
                <ImageView style="@style/NavIcon" android:src="@drawable/ic_ai" android:tint="@color/faint" />
                <TextView style="@style/NavLabel" android:text="AI Tools" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navFav" style="@style/NavItem">
                <ImageView style="@style/NavIcon" android:src="@drawable/ic_heart" android:tint="@color/faint" />
                <TextView style="@style/NavLabel" android:text="Favourites" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navSettings" style="@style/NavItem">
                <ImageView style="@style/NavIcon" android:src="@drawable/ic_settings" android:tint="@color/faint" />
                <TextView style="@style/NavLabel" android:text="Settings" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Floating brand button -->
    <TextView
        android:id="@+id/fabT"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/fab_circle"
        android:elevation="8dp"
        android:gravity="center"
        android:text="T"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

</FrameLayout>
