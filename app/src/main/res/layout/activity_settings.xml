<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:tint="@color/ink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Settings"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView android:id="@+id/rowUpdates" style="@style/AiRow"
            android:text="⬇️  Check for updates\nGet the newest version" />

        <TextView android:id="@+id/rowAccessibility" style="@style/AiRow"
            android:text="♿  Accessibility service\nEnable or manage TapCopy" />

        <TextView style="@style/AiRow"
            android:clickable="false"
            android:text="🔒  Your screen stays private\nText is recognised on your device. Internet is used only to check for and download app updates — your screen text is never uploaded." />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="TapCopy"
            android:textColor="@color/faint"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
