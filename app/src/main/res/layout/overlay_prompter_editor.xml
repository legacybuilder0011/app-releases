<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="10dp">

    <!-- Script panel: placeholder + close in the corner -->
    <FrameLayout
        android:id="@+id/editorPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/scriptInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="top|start"
            android:hint="@string/prompter_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="7"
            android:minLines="4"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="46dp"
            android:paddingBottom="14dp"
            android:scrollbars="vertical"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="18sp"
            android:lineSpacingExtra="4dp"
            android:importantForAutofill="no" />

        <ImageView
            android:id="@+id/closeEditor"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            android:tint="@color/ink"
            android:contentDescription="@string/prompter_close" />
    </FrameLayout>

    <!-- Controls row: tune, paste, saved … play -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tuneButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/prompter_chip"
            android:padding="9dp"
            android:src="@drawable/ic_tune"
            android:tint="@color/ink"
            android:contentDescription="@string/prompter_adjust" />

        <LinearLayout
            android:id="@+id/pasteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/prompter_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_paste"
                android:tint="@color/ink"
                android:contentDescription="@string/prompter_paste" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/prompter_paste"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/savedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/prompter_chip"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp"
            android:text="@string/prompter_saved"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/playButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/play_fab"
            android:padding="13dp"
            android:src="@drawable/ic_play"
            android:contentDescription="@string/prompter_play" />
    </LinearLayout>

    <!-- Speed / text size, opened by the tune button -->
    <LinearLayout
        android:id="@+id/adjustPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minWidth="260dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/prompter_adjust_speed"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/adjustSpeedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand"
                android:textSize="13sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/adjustSpeedSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/prompter_adjust_size"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/adjustSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand"
                android:textSize="13sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/adjustSizeSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40" />
    </LinearLayout>

    <!-- Saved-script list, shown when "Saved" is tapped -->
    <LinearLayout
        android:id="@+id/savedList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/estimateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

</LinearLayout>
