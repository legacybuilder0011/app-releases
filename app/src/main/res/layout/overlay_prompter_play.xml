<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Clipped viewport: the script text is translated upward inside this. -->
    <FrameLayout
        android:id="@+id/scrollClip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:paddingHorizontal="18dp">

        <TextView
            android:id="@+id/scriptText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF" />
    </FrameLayout>

    <TextView
        android:id="@+id/pausedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/prompter_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="@string/prompter_paused"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Temporary control bar (long-press to show, auto-hides) -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/prompter_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/barRestart"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_restart"
            android:tint="@color/ink"
            android:contentDescription="@string/prompter_restart" />

        <ImageView
            android:id="@+id/barSpeed"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_tune"
            android:tint="@color/ink"
            android:contentDescription="@string/prompter_adjust" />

        <TextView
            android:id="@+id/barSpeedValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/barEdit"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_edit"
            android:tint="@color/ink"
            android:contentDescription="@string/prompter_edit" />

        <ImageView
            android:id="@+id/barClose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:tint="@color/ink"
            android:contentDescription="@string/prompter_close" />
    </LinearLayout>

    <!-- Inline close confirmation (no dialog needed from a service) -->
    <LinearLayout
        android:id="@+id/confirmClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC101018"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/prompter_close_confirm"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/confirmCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/prompter_chip"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@android:string/cancel"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/confirmCloseYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/prompter_chip"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/prompter_close"
            android:textColor="@color/danger"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
